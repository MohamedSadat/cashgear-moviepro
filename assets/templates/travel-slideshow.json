{
  "pack": "builtin",
  "version": 1,
  "name": "Travel slideshow",
  "category": "Slideshows",
  "kind": "project",
  "aspect": "landscape",
  "description": "Six photos or clips drifting in slow zooms and pans, with a title and an acoustic bed.",
  "tracks": [
    {
