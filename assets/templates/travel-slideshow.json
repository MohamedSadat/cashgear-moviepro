      "transitions": [
        {
          "from": 0,
          "to": 1,
          "kind": "cross-dissolve",
          "seconds": 0.6
        },
        {
          "from": 1,
          "to": 2,
          "kind": "cross-dissolve",
          "seconds": 0.6
        },
        {
          "from": 2,
          "to": 3,
          "kind": "cross-dissolve",
          "seconds": 0.6
        },
        {
          "from": 3,
          "to": 4,
          "kind": "cross-dissolve",
          "seconds": 0.6
        },
        {
          "from": 4,
          "to": 5,
          "kind": "cross-dissolve",
          "seconds": 0.6
        }
      ]
    },
    {
      "name": "Look",
      "clips": [
        {
          "type": "adjustment",
          "at": 0,
          "seconds": 18,
          "effects": [
            {
              "kind": "vignette",
              "params": {
                "amount": 0.4
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Titles",
      "clips": [
        {
          "type": "title",
          "template": "elegant",
          "at": 0.4,
          "seconds": 3,
          "texts": ["My Journey"]
