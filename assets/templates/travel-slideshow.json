        {
          "type": "slot",
          "slot": 3,
          "at": 6,
          "seconds": 3,
          "motion": "zoomOut"
        },
        {
          "type": "slot",
          "slot": 4,
          "at": 9,
          "seconds": 3,
          "motion": "panRight"
        },
        {
          "type": "slot",
          "slot": 5,
          "at": 12,
          "seconds": 3,
          "motion": "zoomIn"
        },
        {
          "type": "slot",
          "slot": 6,
          "at": 15,
          "seconds": 3,
          "motion": "panLeft"
        }
