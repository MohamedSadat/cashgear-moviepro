{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CashGear Video",
  "version": "1.0.0",
  "identifier": "com.cashgear.video",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CashGear Video",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' blob: ipc: http://ipc.localhost http://cgv-media.localhost cgv-media: https://huggingface.co https://*.hf.co https://*.cashgearerp.com http://127.0.0.1:*",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CashGear",
    "copyright": "© 2026 CashGear",
    "category": "Video",
    "shortDescription": "CashGear Video",
    "longDescription": "A video editor for the browser and the desktop.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/MohamedSadat/cashgear-moviepro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
