      "display": 100,
      "animate": false
    },
    {
      "id": "damping",
      "name": "Damping",
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "step": 0.01,
      "unit": "%",
      "display": 100,
      "animate": false
