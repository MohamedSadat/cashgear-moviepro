{
  "id": "brightness-contrast",
  "name": "Brightness & Contrast",
  "category": "Color",
  "type": "effect",
  "version": 1,
  "description": "Lifts or lowers levels and stretches them around mid grey.",
  "space": "srgb",
  "params": [
    {
      "id": "brightness",
      "name": "Brightness",
      "type": "number",
      "min": -1,
      "max": 1,
      "default": 0,
      "step": 0.01,
      "unit": "%",
      "display": 100
    },
    {
      "id": "contrast",
      "name": "Contrast",
      "type": "number",
      "min": -1,
      "max": 1,
      "default": 0,
      "step": 0.01,
      "unit": "%",
      "display": 100
    }
  ]
}
