{
  "id": "color-wheels",
  "name": "Color Wheels",
  "category": "Color",
  "type": "effect",
  "version": 1,
  "description": "Primary correction: lift moves the shadows, gamma the midtones, gain the highlights and offset everything, each in brightness and towards a colour.",
  "space": "srgb",
  "params": [
