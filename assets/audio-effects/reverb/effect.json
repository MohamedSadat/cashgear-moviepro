    {
      "id": "width",
      "name": "Width",
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 1,
      "step": 0.01,
      "unit": "%",
      "display": 100,
      "animate": false
    },
    {
      "id": "mix",
      "name": "Mix",
      "type": "number",
      "min": 0,
