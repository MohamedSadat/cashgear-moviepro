{
  "id": "low-pass",
  "name": "Low-pass filter",
  "category": "Tone",
  "type": "audio",
  "version": 1,
  "description": "Removes hiss and brightness above a frequency.",
  "params": [
    {
      "id": "frequency",
      "name": "Frequency",
      "type": "number",
      "min": 200,
      "max": 20000,
      "default": 8000,
      "step": 1,
      "unit": "Hz",
      "animate": false
    },
    {
      "id": "slope",
      "name": "Slope",
      "type": "choice",
      "options": [
        {
          "id": "gentle",
          "name": "12 dB an octave"
        },
        {
          "id": "steep",
          "name": "24 dB an octave"
        }
      ],
      "default": "gentle",
      "animate": false
    }
  ]
}
