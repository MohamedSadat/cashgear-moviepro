{
  "name": "cashgear-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "setup:wasm": "node scripts/setup-wasm.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "setup:ffmpeg": "node scripts/build-ffmpeg-lgpl.mjs",
    "dev:web": "node scripts/dev.mjs",
    "dev:desktop": "pnpm --filter @cgv/desktop dev",
    "build": "pnpm build:wasm --release && pnpm --filter @cgv/web build && node scripts/third-party-notices.mjs",
    "preview": "pnpm --filter @cgv/web preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop:build": "pnpm build && pnpm --filter @cgv/desktop build",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:installer": "node scripts/desktop-installer.mjs",
    "desktop:installer-test": "node scripts/installer-test.mjs",
    "deny": "cargo deny check licenses sources",
    "licenses:check": "node scripts/check-licenses.mjs",
    "licenses:selftest": "node scripts/license-selftest.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "release:check": "node scripts/release-check.mjs",
    "fetch-test-media": "node scripts/fetch-test-media.mjs",
    "fetch-models": "node scripts/fetch-models.mjs",
    "make-test-media": "node scripts/make-test-media.mjs",
    "fetch-fonts": "node scripts/fetch-fonts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "binaryen": "^123.0.0",
    "eslint": "^10.13.0",
    "globals": "^16.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
