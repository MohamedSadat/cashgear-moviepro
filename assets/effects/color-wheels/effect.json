      "id": "lift_hue",
      "name": "Lift hue",
      "type": "number",
      "min": 0,
      "max": 360,
      "default": 0,
      "step": 1,
      "unit": "\u00b0"
    },
    {
      "id": "lift_amount",
      "name": "Lift colour",
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 0,
      "step": 0.01,
      "unit": "%",
      "display": 100
    },
